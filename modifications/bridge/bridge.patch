+    "新监听器已添加。监听器: {}": "New listener added. Listener: {}",
+    "新连接已接受。本地: {}, 远程: {}": "New connection accepted. Local: {}, remote: {}",
+    "连接错误。本地: {}, 远程: {}, 错误: {}":
+        "Connection error. Local: {}, remote: {}, error: {}",
+    "TUN 设备就绪。设备: {}": "TUN device ready. Device: {}",
+    "TUN 设备错误。错误: {}": "TUN device error. Error: {}",
+    "正在连接到节点。目标: {}": "Connecting to peer. Destination: {}",
+    "连接到节点错误。目标: {}, IP版本: {}, 错误: {}":
+        "Could not connect to peer. Destination: {}, IP version: {}, error: {}",
+    "VPN 门户已启动。门户: {}": "VPN portal started. Portal: {}",
+    "VPN 门户客户端已连接。门户: {}, 客户端地址: {}":
+        "VPN portal client connected. Portal: {}, client address: {}",
+    "VPN 门户客户端已断开连接。门户: {}, 客户端地址: {}":
+        "VPN portal client disconnected. Portal: {}, client address: {}",
+    "DHCP IP 已更改。旧: {:?}, 新: {:?}": "DHCP IP changed. Previous: {}, new: {}",
+    "DHCP IP 冲突。IP: {:?}": "DHCP IP conflict. IP: {}",
+    "端口转发已添加。配置: {:?}": "Port forwarding added. Configuration: {}",
+    "接收事件错误: {:?}": "Could not receive event: {}",
+    "事件通道已关闭，停止事件处理。": "Event channel closed. Event processing stopped.",
+    "事件处理滞后，丢失了 {} 个事件。": "Event processing lagged; {} events were dropped.",
+    "实例已成功储存": "Network instance saved",
+    "网络实例已存在": "Network instance already exists",
+    "成功储存": "Saved",
+    "添加端口转发: {} -> {} -{}": "Add port forwarding: {} -> {} -{}",
+    "关闭前实例状态: {}": "Network state before closing: {}",
+    "存在": "Present",
+    "不存在": "Not present",
+    "正在关闭实例": "Closing network instance",
+    "实例已成功关闭": "Network instance closed",
+    "没有找到需要关闭的实例": "No network instance to close",
+    "关闭后实例状态: {}": "Network state after closing: {}",
+    "无法获取运行信息": "Could not get network information",
+    "没有运行中的网络实例": "No running network instance",
+    "未知": "Unknown",
+    "TCP转发和组播服务已启动": "TCP forwarding and multicast service started",
+    "监听: 0.0.0.0:25568 -> 43.248.189.79:25565":
+        "Listening: 0.0.0.0:25568 -> 43.248.189.79:25565",
+    "组播: 224.0.2.60:4445": "Multicast: 224.0.2.60:4445",
+  };
+  static final _placeholder = RegExp(r'\{[^{}]*\}');
+  static final _han = RegExp(r'[\u3400-\u9fff]');
+  static final _logPrefix = RegExp(r'^(\[[^\]]+\]\s*)+');
+  static final _literals = Map.fromEntries(
+    _translations.entries.where((entry) => !_placeholder.hasMatch(entry.key)),
+  );
+  static final _rules = _translations.entries
+      .where((entry) => _placeholder.hasMatch(entry.key))
+      .map((entry) => _NativeRule(entry.key, entry.value, _placeholder))
+      .toList(growable: false);
+
+  static String english(String text) {
+    if (!_han.hasMatch(text)) return text;
+    return text.split('\n').map(_line).join('\n');
+  }
+
+  static String _line(String text) {
+    if (text.contains('创建服务器: ') && text.contains('房间密码: ')) {
+      return 'Starting virtual network (room credentials omitted)';
+    }
+    final literal = _literals[text];
+    if (literal != null) return literal;
+    final logged = _logPrefix.firstMatch(text);
+    if (logged != null) {
+      final value = _literals[text.substring(logged.end)];
+      if (value != null) return text.substring(0, logged.end) + value;
+    }
+    for (final entry in _literals.entries) {
+      for (final prefix in ['AnyhowException(', 'PanicException(']) {
+        final wrapped = '$prefix${entry.key})';
+        if (text.contains(wrapped)) {
+          return text.replaceAll(wrapped, '$prefix${entry.value})');
+        }
+      }
+    }
+    for (final rule in _rules) {
+      if (!text.contains(rule.prefix)) continue;
+      final match = rule.pattern.firstMatch(text);
+      if (match == null) continue;
+      final result = StringBuffer(text.substring(0, match.start));
+      for (var i = 0; i < rule.output.length; i++) {
+        result.write(rule.output[i]);
+        if (i < rule.output.length - 1) result.write(match.group(i + 1) ?? '');
+      }
+      return result.toString();
+    }
+    return text;
+  }
+}
+
+class _NativeRule {
+  final String prefix;
+  final RegExp pattern;
+  final List<String> output;
+  _NativeRule(String source, String english, RegExp placeholder)
+    : prefix = source.split(placeholder).first,
+      pattern = RegExp(
+        '${source.split(placeholder).map(RegExp.escape).join('(.*?)')}\$',
+        dotAll: true,
+      ),
+      output = english.split(placeholder);
+}
